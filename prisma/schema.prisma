generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id     String  @id @default(cuid())
  email  String  @unique
  name   String? // Username/display name (from Google or manual input)
  avatar String? // Profile picture URL (from Google or uploaded)

  // Authentication
  googleId      String?   @unique // For Google OAuth (optional, if user logs in via Google)
  password      String? // Hashed password for manual login (if not using OAuth)
  emailVerified DateTime?

  // User Type / Role
  role Role @default(USER) // USER, ADMIN, MODERATOR

  // Soft Delete
  isActive Boolean @default(true) // Mark as inactive instead of deleting

  // Reputation (v2)
  reputation      Int     @default(0) // Denormalised sum of ReputationEvent.points
  verifiedStudent Boolean @default(false) // Granted by a moderator; audited

  // Relations
  itemsPosted    Item[]    @relation("itemsPosted") // Items this user posted (lost items)
  itemsClaimed   Item[]    @relation("itemsClaimed") // Items this user has claimed (found items)
  itemsModerated Item[]    @relation("itemsModerated")
  itemsDeleted   Item[]    @relation("itemsDeleted")
  comments       Comment[]
  claims         Claim[]

  // Relations (v2)
  notifications      Notification[]    @relation("NotificationRecipient")
  actedNotifications Notification[]    @relation("NotificationActor")
  savedSearches      SavedSearch[]
  reputationEvents   ReputationEvent[]
  auditLogs          AuditLog[]

  // Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Security - Account lockout and failed login tracking
  failedLoginAttempts Int       @default(0) // Track failed login attempts
  lockedUntil         DateTime? // Account locked until this time
  sessionVersion      Int       @default(0)

  @@index([isActive, createdAt])
  @@index([role])
  @@index([lockedUntil])
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

model Item {
  id          String     @id @default(cuid())
  title       String // Item name (e.g., "Red iPhone 15")
  description String // Detailed description
  itemType    ItemType // LOST or FOUND
  status      ItemStatus @default(LOST) // Current state of item
  location    String // Where lost/found (free text, kept for back-compat)
  images      String[]   @default([]) // Array of image URLs

  // Classification (v2)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  zoneId     String?
  zone       CampusZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  tags       String[]    @default([]) // Normalised lowercase tags, max 8
  latitude   Float? // Optional precise pin
  longitude  Float?

  // Relations
  postedById String
  postedBy   User   @relation("itemsPosted", fields: [postedById], references: [id])

  claimedById String?
  claimedBy   User?   @relation("itemsClaimed", fields: [claimedById], references: [id])

  comments      Comment[]
  claims        Claim[]
  moderatedById String?
  moderatedBy   User?     @relation("itemsModerated", fields: [moderatedById], references: [id], onDelete: SetNull)
  deletedById   String?
  deletedBy     User?     @relation("itemsDeleted", fields: [deletedById], references: [id], onDelete: SetNull)

  // Relations (v2)
  matchesAsLost      MatchSuggestion[] @relation("MatchAsLost")
  matchesAsFound     MatchSuggestion[] @relation("MatchAsFound")
  notifications      Notification[]
  reputationEvents   ReputationEvent[]

  // Metadata
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  resolvedAt       DateTime?
  moderationStatus ItemModerationStatus @default(NONE)
  moderatedAt      DateTime?
  moderationReason String?
  deletedAt        DateTime?
  deletionReason   String?

  @@index([postedById, createdAt])
  @@index([claimedById])
  @@index([status, createdAt])
  @@index([itemType, status, createdAt])
  @@index([location, createdAt])
  @@index([moderationStatus, createdAt])
  @@index([moderatedById])
  @@index([deletedById])
  @@index([deletedAt])
  @@index([categoryId, createdAt])
  @@index([zoneId, createdAt])
  // The default list filters `status <> DELETED` and orders by `createdAt desc`.
  // Without an index leading with createdAt nothing could supply that ordering,
  // so every page view was a sequential scan plus a top-N sort (measured at
  // 37 ms for 20 rows over 20,000 items, versus 0.59 ms on the audit log, which
  // has this index). A partial index on `status <> 'DELETED'` would be slightly
  // tighter, but Prisma cannot model partial indexes and would report drift.
  @@index([createdAt])
  @@index([tags(ops: ArrayOps)], type: Gin)
}

enum ItemType {
  LOST // User lost this item
  FOUND // User found this item
}

enum ItemStatus {
  LOST // Actively being searched for
  FOUND // Item was found
  CLAIMED // Someone claimed it
  RESOLVED // Successfully returned
  DELETED // Item no longer active (soft delete)
}

enum ItemModerationStatus {
  NONE
  FLAGGED
  REMOVED
}

model Comment {
  id      String   @id @default(cuid())
  message String // Comment text
  images  String[] @default([]) // Optional proof pictures in comments

  // Relations
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId, createdAt])
  @@index([userId, createdAt])
}

model Claim {
  id        String      @id @default(cuid())
  claimType ClaimType // FOUND_IT or OWN_IT
  status    ClaimStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  message   String? // Optional explanation/proof from claimer

  // Relations
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime? // When approved or rejected

  // Handover verification (v2)
  handoverCode          String? // 6-digit code proving a physical handover
  handoverCodeExpiresAt DateTime?
  handoverAttempts      Int       @default(0) // Wrong-code attempts; invalidated at 5
  handoverVerifiedAt    DateTime?
  completedAt           DateTime?

  @@index([itemId, status, createdAt])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([resolvedAt])
  @@index([handoverCode, status])
  // NOTE: a partial unique index enforces one active claim per item:
  //   CREATE UNIQUE INDEX "Claim_approved_item_key" ON "Claim" ("itemId")
  //     WHERE "status" IN ('APPROVED', 'COMPLETED');
  // Prisma does not model partial indexes, so it lives in the migrations only.
  // Widen the predicate whenever another "active return" status is added.
}

enum ClaimType {
  FOUND_IT // Finder claiming they found the item
  OWN_IT // Owner claiming they own the found item
}

enum ClaimStatus {
  PENDING // Waiting for item poster to review
  APPROVED // Claim approved, exchange can happen
  COMPLETED // Handover verified with the code issued at approval
  REJECTED // Claim rejected by item poster
}

model Category {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  icon      String // lucide-react icon name
  sortOrder Int    @default(0)

  items Item[]

  createdAt DateTime @default(now())

  @@index([sortOrder])
}

model CampusZone {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  mapX        Float // Normalised 0-100 position on the schematic campus map
  mapY        Float
  sortOrder   Int     @default(0)

  items Item[]

  createdAt DateTime @default(now())

  @@index([sortOrder])
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId String?
  actor   User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type    NotificationType

  // Rendered at write time so the inbox stays readable if the source disappears
  title String
  body  String
  link  String?

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([itemId])
}

enum NotificationType {
  CLAIM_CREATED
  CLAIM_STATUS_CHANGED
  COMMENT_ON_ITEM
  MATCH_FOUND
  SAVED_SEARCH_HIT
  HANDOVER_CODE_ISSUED
  HANDOVER_CODE_INVALIDATED
  HANDOVER_VERIFIED
  ITEM_RESOLVED
  MODERATION_ACTION
}

model SavedSearch {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name    String
  filters Json // Validated against savedSearchFiltersSchema on write

  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, createdAt])
}

model MatchSuggestion {
  id          String      @id @default(cuid())
  lostItemId  String
  lostItem    Item        @relation("MatchAsLost", fields: [lostItemId], references: [id], onDelete: Cascade)
  foundItemId String
  foundItem   Item        @relation("MatchAsFound", fields: [foundItemId], references: [id], onDelete: Cascade)
  score       Int // 0-100
  reasons     Json // [{ code, label, weight }] so the UI can explain the pairing
  status      MatchStatus @default(SUGGESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lostItemId, foundItemId])
  @@index([lostItemId, status])
  @@index([foundItemId, status])
  @@index([status, score])
}

enum MatchStatus {
  SUGGESTED
  DISMISSED
  CONFIRMED
}

model ReputationEvent {
  id     String         @id @default(cuid())
  userId String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   ReputationKind
  points Int
  itemId String?
  item   Item?           @relation(fields: [itemId], references: [id], onDelete: SetNull)
  note   String?

  createdAt DateTime @default(now())

  // Makes awards idempotent: replaying a lifecycle transition cannot double-credit
  @@unique([userId, kind, itemId])
  @@index([userId, createdAt])
}

enum ReputationKind {
  ITEM_POSTED
  COMMENT_POSTED
  CLAIM_APPROVED
  RETURN_COMPLETED
  MODERATION_UPHELD
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String // Denormalised so history survives user deletion
  action     AuditAction
  targetType String // Item | User | Claim
  targetId   String
  reason     String?
  metadata   Json?
  ip         String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
}

enum AuditAction {
  ITEM_FLAG
  ITEM_REMOVE
  ITEM_RESTORE
  ITEM_DELETE
  USER_ROLE_CHANGE
  USER_DEACTIVATE
  USER_REACTIVATE
  CLAIM_OVERRIDE
  BULK_ITEM_ACTION
  BULK_USER_ACTION
  EXPORT_DOWNLOAD
}
