{
  "name": "campushelper",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:validate": "if [ -n \"${DATABASE_URL:-}\" ] && [ -n \"${DIRECT_URL:-}\" ]; then prisma validate; elif [ -n \"${DATABASE_URL:-}\" ]; then DIRECT_URL=\"$DATABASE_URL\" prisma validate; elif [ -n \"${DIRECT_URL:-}\" ]; then DATABASE_URL=\"$DIRECT_URL\" prisma validate; else printf '%s\\n' 'DATABASE_URL and DIRECT_URL are not set; skipping db:validate'; fi",
    "db:generate": "prisma generate",
    "db:verify": "tsx scripts/verify-migrations.ts",
    "db:backfill-matches": "tsx scripts/backfill-matches.ts",
    "verify": "npm run db:generate && if [ -n \"${DATABASE_URL:-}\" ] || [ -n \"${DIRECT_URL:-}\" ]; then npm run db:validate && npm run db:verify; else printf '%s\\n' 'DATABASE_URL and DIRECT_URL are not set; skipping database verification'; fi && npm run type-check && npm run lint && npm test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/dompurify": "^3.0.5",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.2",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.546.0",
    "next": "^16.3.8",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "rate-limiter-flexible": "^8.1.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-hook-form": "^7.65.0",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.1.15",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1",
    "zod": "$zod"
  }
}
